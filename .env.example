# Local Ollama service and model used by the FastAPI backend.
APP_NAME=RepoDoctor AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_SECONDS=120
MAX_CODE_CHARS=20000
# Exact browser origins allowed to read this API. Do not use '*'.
# Keep the Render frontend origin for its optional browser-to-local-backend mode.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://repodoctor-ai.onrender.com
